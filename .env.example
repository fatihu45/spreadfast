# Environment Variables (for future use)
# Backend origin only; callers append /api.
REACT_APP_API_URL=http://localhost:5000
NODE_ENV=development

# Backend-only Quick Ads admin estimates; do not prefix these with REACT_APP_.
# Set the actual provider estimate and your chosen NGN/USD exchange rate on Render.
QUICK_AD_GENERATION_COST_USD=
USD_NGN_RATE=

# Backend email: existing RESEND_API_KEY, ADMIN_EMAIL and FRONTEND_URL/CLIENT_URL are reused.
# Production defaults to enabled; false pauses delivery. Development defaults to disabled.
# EMAILS_ENABLED=true
# Non-production sending also requires a test inbox; all recipients are redirected there.
EMAIL_TEST_RECIPIENT=
